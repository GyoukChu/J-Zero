__pycache__/
*.pyc
.env
.orig
outputs/
.venv*/
wandb/
*.log

# benchmark run artifacts (working files created by runs)
benchmarks/outputs/eval/

# ... but benchmarks/outputs/eval_gen/ is an INPUT the suite reads, not an
# artifact it writes: AlpacaEval's 805 prompts + the official GPT-4-Turbo
# reference, which run_eval.sh requires (see its alpaca phase). The blanket
# `outputs/` rule above hides it, and git will not descend into an excluded
# directory, so the parents have to be un-ignored before the re-include.
!benchmarks/outputs/
benchmarks/outputs/*
!benchmarks/outputs/eval_gen/
benchmarks/third_party/creative-writing-bench/creative_bench_runs.PRISTINE.json
benchmarks/third_party/creative-writing-bench/creative_bench_runs.json
benchmarks/third_party/*-lane2/
benchmarks/third_party/alpaca_eval
benchmarks/third_party/BIG-Bench-Hard
benchmarks/third_party/arena-hard-auto/data/arena-hard-v2.0/model_answer/*
!benchmarks/third_party/arena-hard-auto/data/arena-hard-v2.0/model_answer/gemini-2.0-flash-001.jsonl
!benchmarks/third_party/arena-hard-auto/data/arena-hard-v2.0/model_answer/o3-mini-2025-01-31.jsonl
benchmarks/third_party/arena-hard-auto/data/arena-hard-v2.0/model_judgment/

# runtime artifacts (regenerated by runs)
baselines/r-zero/data/dummy_train*.parquet
pipeline/data/dummy_train*.parquet
benchmarks/third_party/creative-writing-bench/*.lock
benchmarks/third_party/creative-writing-bench/data/*.lock
benchmarks/third_party/creative-writing-bench/creative_bench_runs_*.json
