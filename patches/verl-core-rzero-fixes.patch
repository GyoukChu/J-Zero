     # in current ray environment, LOCAL_RANK is always zero.
 
+    import time
+
     import torch.distributed
 
     timeout = timedelta(seconds=timeout_second) if timeout_second is not None else None
@@ -87,13 +89,60 @@ def initialize_global_process_group_ray(timeout_second=None, backend=None):
     if not torch.distributed.is_initialized():
         rank = int(os.environ.get("RANK", 0))
         world_size = int(os.environ.get("WORLD_SIZE", 1))
-        torch.distributed.init_process_group(
-            backend=backend,
-            rank=rank,
-            world_size=world_size,
-            timeout=timeout,
-            init_method=os.environ.get("DIST_INIT_METHOD", None),
-        )
+        init_method = os.environ.get("DIST_INIT_METHOD", None)
+
+        # [J-Zero patch] When ray launches many
+        # actors concurrently after a previous phase's vLLM workers have been
+        # pkilled, the MASTER_PORT picked by ray.get_master_addr_port can
+        # transiently collide with a stale TCPStore listener (TIME_WAIT or a
+        # ray-internal port grab), yielding "RuntimeError: nonce == returnedNonce"
+        # on the client TCPStore ping or "EADDRINUSE" on the rank-0 listen.
+        #
+        # NB: retrying inside the worker cannot change MASTER_PORT (already
+        # baked into the actor's environment at spawn time), so retrying only
+        # buys time for the stale listener to die. The real fix lives in
+        # single_controller/ray/base.py:get_master_addr_port which now picks
+        # from a randomised high-range pool. This retry remains as a belt-and-
+        # suspenders safety net for the rare case where the chosen port races
+        # with a vLLM EngineCore IPC socket grab.
+        max_attempts = int(os.environ.get("VERL_PG_INIT_MAX_ATTEMPTS", "4"))
+        backoff_s = float(os.environ.get("VERL_PG_INIT_BACKOFF_S", "5.0"))
+        last_exc = None
+        for attempt in range(1, max_attempts + 1):
+            try:
+                torch.distributed.init_process_group(
+                    backend=backend,
+                    rank=rank,
+                    world_size=world_size,
+                    timeout=timeout,
+                    init_method=init_method,
+                )
+                last_exc = None
+                break
+            except RuntimeError as e:
+                # Note: PyTorch's DistNetworkError (subclass of RuntimeError)
+                # is what actually fires on TCPStore-listen collisions, and
+                # the message text is lowercase "address already in use". Match
+                # case-insensitively + accept the EADDRINUSE keyword too.
+                msg = str(e).lower()
+                # Only retry on the transient TCPStore rendezvous failure modes.
+                # Re-raise immediately for anything else so we don't mask real bugs.
+                transient = (
+                    "nonce == returnednonce" in msg
+                    or "address already in use" in msg
+                    or "eaddrinuse" in msg
+                )
+                if not transient or attempt == max_attempts:
+                    raise
+                last_exc = e
+                print(
+                    f"[verl distributed] init_process_group attempt {attempt}/{max_attempts} "
+                    f"failed (rank={rank}): {str(e).splitlines()[0]}; retrying in {backoff_s}s",
+                    flush=True,
+                )
+                time.sleep(backoff_s)
+        if last_exc is not None:
+            raise last_exc
 
 
