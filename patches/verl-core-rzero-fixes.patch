diff --git a/verl/trainer/main_ppo.py b/verl/trainer/main_ppo.py
index 8f6cd416..199cb40c 100644
--- a/verl/trainer/main_ppo.py
+++ b/verl/trainer/main_ppo.py
@@ -312,7 +312,129 @@ class TaskRunner:
         trainer.init_workers()
 
         # Start the training process.
-        trainer.fit()
+        _fit_failed = True
+        try:
+            trainer.fit()
+            _fit_failed = False
+        finally:
+            # [J-Zero patch] Close the wandb run HERE, from the thread that ran
+            # training, instead of leaving it to Tracking.__del__. __del__ runs
+            # while this ray actor's interpreter is shutting down, by which
+            # point the collection happens on wandb's own asyncio-manager
+            # thread — and wandb's run() refuses to be called from that thread.
+            # So every stage ended a *successful*, checkpoint-saved run with
+            #   Exception ignored in: <function Tracking.__del__ ...>
+            #     File ".../wandb/sdk/lib/asyncio_manager.py", line 132, in run
+            #   ValueError: Cannot use run() inside async loop.
+            # plus BrokenPipeError / closed-UnixTransport follow-ups, which
+            # makes a long multi-round run impossible to judge from its log.
+            # Finishing early also flushes the run before ray tears the actor
+            # down. wandb.finish() is a no-op when no run is active, so a
+            # Tracking.__del__ that fires after this point is harmless.
+            # This does NOT catch every case: a Tracking collected while fit()
+            # is still running is out of reach of a finally that runs after it,
+            # and the solver stage has been observed to emit one such traceback
+            # on an otherwise clean run. Teardown noise must never mask a real
+            # training exception: swallow anything raised.
+            #
+            # exit_code is passed explicitly. wandb's own default is None, and
+            # Run._atexit_cleanup resolves `exit_code or ... or 0`, so finishing
+            # a crashed stage without it would file the run as SUCCEEDED — a
+            # green dashboard for a stage that raised, which is worse than the
+            # traceback this patch removes.
+            try:
+                import threading
+
+                import wandb
+
+                _exit_code = 1 if _fit_failed else 0
+
+                def _wandb_shutdown():
+                    # Swallow here, NOT in the caller: this body runs on another
+                    # thread, so an escaping exception is printed by
+                    # threading.excepthook as a full traceback — reintroducing
+                    # exactly the teardown noise this patch exists to remove.
+                    try:
+                        if wandb.run is not None:
+                            wandb.finish(exit_code=_exit_code)
+                        # finish() ends the run but leaves wandb's service process
+                        # and its atexit hook alive. That hook
+                        # (service_connection.py teardown_atexit) then runs during
+                        # interpreter shutdown and ends a *successful* stage with
+                        #   Exception ignored in atexit callback: <... teardown_atexit>
+                        #   ...  await self._writer.wait_closed()
+                        #   BrokenPipeError: [Errno 32] Broken pipe
+                        # teardown() does the same work now, while the interpreter
+                        # is healthy, and its ServiceConnection.teardown() calls
+                        # the cleanup that atexit.unregister()s the hook, so
+                        # nothing is left to fire later.
+                        wandb.teardown(exit_code=_exit_code)
+                    except Exception as e:  # noqa: BLE001
+                        print(f"[verl main_ppo] wandb shutdown failed (ignored): {e}", flush=True)
+
+                # [J-Zero patch] Bound the teardown so an unreachable wandb
+                # backend cannot hang every stage with the GPUs idle, silently
+                # stalling a long launcher.
+                #
+                # The PRIMARY bound is wandb's own `finish_timeout`, exported as
+                # WANDB_FINISH_TIMEOUT by env_prelude.sh. It stops the upload wait
+                # in-process, leaves the data on disk for the `wandb sync` the
+                # stage scripts already run, and marks the run Crashed rather than
+                # leaving it silently truncated.
+                #
+                # The thread below is only a belt-and-braces OUTER bound, for
+                # hangs finish_timeout does not cover (e.g. a stuck service
+                # handshake). Reaching it is a degraded path — see the message.
+                _tmo = float(os.environ.get("JZERO_WANDB_SHUTDOWN_TIMEOUT", "120"))
+                _t = threading.Thread(target=_wandb_shutdown, daemon=True)
+                _t.start()
+                _t.join(_tmo)
+                if _t.is_alive():
+                    print(
+                        f"[verl main_ppo] wandb shutdown still running after {_tmo:.0f}s; "
+                        "abandoning it. The run may stay 'running' in wandb, a "
+                        "Tracking.__del__ and/or atexit BrokenPipeError traceback may "
+                        "follow at exit, and the metrics tail may be missing. Training "
+                        "and checkpoints are unaffected; `wandb sync` can still upload "
+                        "the on-disk run data.",
+                        flush=True,
+                    )
+            except Exception as e:  # noqa: BLE001
+                print(f"[verl main_ppo] wandb shutdown thread failed (ignored): {e}", flush=True)
+
+            # [J-Zero patch] Quiesce the DataLoader workers for the same reason.
+            # ray_trainer.py builds the train/val StatefulDataLoaders with
+            # data.dataloader_num_workers (default 8), and torch arms a SIGCHLD
+            # handler that turns any worker death into an exception
+            # (torch/utils/data/_utils/signal_handling.py). Once fit() has
+            # returned the workers are only being torn down, but the handler is
+            # still armed, so the reap surfaced as
+            #     File ".../_utils/signal_handling.py", line 73, in handler
+            #       _error_if_any_worker_fails()
+            #   RuntimeError: DataLoader worker (pid ...) is killed by signal: Killed.
+            # raised straight through ray's run_task_loop on a *successful*,
+            # checkpoint-saved stage. Drop the iterators and collect so the
+            # workers exit while the interpreter is still healthy, then disarm
+            # the handler so a late or forced reap stays silent. This runs only
+            # after fit() has returned or raised, so it cannot hide a worker
+            # failure that mattered to training. signal.signal() is valid here
+            # because torch armed the handler from this same (main) thread.
+            try:
+                import gc as _gc
+                import signal as _signal
+
+                from torch.utils.data._utils import signal_handling as _sig
+
+                for _name in ("train_dataloader", "val_dataloader"):
+                    _dl = getattr(trainer, _name, None)
+                    if _dl is not None and getattr(_dl, "_iterator", None) is not None:
+                        _dl._iterator = None
+                _gc.collect()
+                if getattr(_sig, "_SIGCHLD_handler_set", False):
+                    _signal.signal(_signal.SIGCHLD, _signal.SIG_DFL)
+                    _sig._SIGCHLD_handler_set = False
+            except Exception as e:  # noqa: BLE001
+                print(f"[verl main_ppo] dataloader quiesce failed (ignored): {e}", flush=True)
 
 
