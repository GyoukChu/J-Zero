# EQ-Bench Creative Writing v3 — LOCAL-only config (zero external API calls).
#
# Copy this file to `.env` IN THIS DIRECTORY before running the eval suite:
#     cp .env_example .env
# (benchmarks/scripts/eval_standard/run_eval.sh also creates `.env` from this
# file automatically if it is missing, so the copy is a convenience, not a
# prerequisite.)
#
# WHY IT MUST EXIST: with no `.env`, the harness silently falls back to
# https://api.openai.com — the run would leave the machine and send prompts to
# an external API. Everything in this suite is meant to stay local.
#
# ABOUT THE URLS BELOW: they are placeholders matching the default PORT_BASE of
# 7400. Both endpoints are served locally by
# benchmarks/scripts/eval_gen/serve_judge_vllm.sh, and run_eval.sh REWRITES both
# host ports on every run (test -> PORT_BASE+51, judge -> PORT_BASE+32), so you
# never need to edit them by hand — not even when running two lanes on different
# port bands. The API keys are dummies; nothing checks them.

# Model under test: local OpenAI-compatible endpoint.
TEST_API_URL=http://127.0.0.1:7451/v1/chat/completions
TEST_API_KEY=dummy-local-test

# Judge: local gemma-4-31b-it endpoint.
JUDGE_API_URL=http://127.0.0.1:7432/v1/chat/completions
JUDGE_API_KEY=dummy-local-judge

MAX_RETRIES=3
RETRY_DELAY=5
REQUEST_TIMEOUT=600
LOG_VERBOSITY=INFO
